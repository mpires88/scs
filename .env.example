# Copy to .env and fill in from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to "true" only for local development before auth is configured.
# Never deploy with this on.
NEXT_PUBLIC_DISABLE_AUTH=false
