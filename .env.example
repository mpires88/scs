# Copy to .env and fill in from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to "true" only for local development before auth is configured.
# Only honored by `next dev` (NODE_ENV=development); production builds ignore it.
NEXT_PUBLIC_DISABLE_AUTH=false
